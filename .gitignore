.DS_Store
.vscode/
__pycache__/
*.pyc

# Build caches: the Go side-channel's GOPATH/GOCACHE and measure_weapons.mjs's
# vendored three.js copy.
.build/

# Uncompressed map geometry. The tracked form is
# maps/optimized_obj_files/*.obj.zip, unpacked by scripts/extract_maps.py
# (~134 MB per map once unpacked).
*.obj
# Optional per-triangle colour sidecar; a map is 7-21 MB and the feature is off
# by default (map-loader.js BAKED_COLORS).
maps/optimized_obj_files/*.colors.bin

# The web app's own data: config, the SQLite library, .csz files, thumbnails,
# avatars. Anchored on purpose -- it lives under app/ now, and the repo root's
# data/ is a different thing entirely (training data).
/app/data/

# Replays written by visualizer/server.py on POST /api/load.
visualizer/outputs/

# Training data, checkpoints and runs.
/data/
/models/
/runs/

# Local demo files. Anchored to the repo root on purpose: an unanchored
# "examples/" also matches visualizer/static/three/examples/, which would
# silently block the vendored three.js addons (GLTFLoader,
# BufferGeometryUtils) from ever being committed -- and that only shows up on
# a fresh clone, where the importmap would then 404.
/examples/

# visualizer/static/assets/ (weapon models, textures, sprites, HUD icons,
# radars) is tracked on purpose: a clean checkout cannot rebuild it without a
# local CS2 install. It is Valve's content, not MIT -- see README "Licensing".
